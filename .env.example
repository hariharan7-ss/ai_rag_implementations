# LLM Provider
GROQ_API_KEY=your_groq_api_key_here

# Vector Store
PINECONE_API_KEY=your_pinecone_api_key_here

# Namespace the app reads and writes. Keeps this project's documents apart from
# anything else in the same index. Empty = the shared default namespace (unscoped).
PINECONE_NAMESPACE=solstice

